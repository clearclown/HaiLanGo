# HaiLanGo - Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values

# GCP Project Configuration
project_id     = "hailango"
project_number = "1077128828066"
region         = "asia-northeast1"  # Tokyo region
environment    = "development"

# Billing Configuration
# Get your billing account ID from: gcloud billing accounts list
billing_account_id = ""  # Format: XXXXXX-XXXXXX-XXXXXX

# Budget Configuration
monthly_budget_amount   = 50  # USD
budget_alert_thresholds = [0.5, 0.8, 0.9, 1.0]  # Alert at 50%, 80%, 90%, 100%

# API Keys
create_api_keys = true

# Storage Configuration
storage_location = "ASIA"
storage_class    = "STANDARD"

# Alert notifications (add your email addresses)
alert_notification_emails = [
  # "your-email@example.com",
]
