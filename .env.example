# ============================================
# HaiLanGo - 環境変数設定ファイル
# ============================================
#
# 使用方法:
# 1. このファイルをコピーして .env を作成
#    cp .env.example .env
#
# 2. 各環境変数の値を実際の値に置き換える
#
# 3. APIキーがなくてもテスト可能:
#    - テスト環境では自動的にモックが使用されます
#    - USE_MOCK_APIS=true を設定すると開発時もモックを使用可能
#
# ============================================

# ============================================
# アプリケーション基本設定
# ============================================

# アプリケーション環境
APP_ENV=development

# アプリケーション名
APP_NAME=HaiLanGo

# デバッグモード（開発時のみ true）
DEBUG=true

# ============================================
# サーバー設定
# ============================================

# バックエンドサーバーポート
BACKEND_PORT=8080

# フロントエンドサーバーポート
FRONTEND_PORT=3000

# サーバーホスト（0.0.0.0 に設定するとVPN構成内からの接続も可能）
SERVER_HOST=0.0.0.0

# ============================================
# データベース設定（PostgreSQL）
# ============================================

DATABASE_URL=postgresql://HaiLanGo:password@localhost:5432/HaiLanGo_dev
POSTGRES_USER=HaiLanGo
POSTGRES_PASSWORD=password
POSTGRES_DB=HaiLanGo_dev

# ============================================
# Redis設定
# ============================================

REDIS_URL=redis://localhost:6379

# ============================================
# JWT認証設定
# ============================================

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# モック設定（テスト・開発用）
# ============================================

# モックAPIを使用するかどうか（APIキーなしでも開発可能）
USE_MOCK_APIS=false

# ============================================
# フロントエンド設定
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:8080

# ============================================
# Google Cloud設定
# ============================================
#
# 重要: OAuth 2.0 Client ID (client_secret_*.json) ではなく
#       Service Account JSON が必要です！
#
# Service Account の作成方法:
# 1. Google Cloud Console (https://console.cloud.google.com/)
# 2. IAMと管理 → サービスアカウント → 作成
# 3. ロール: Cloud Vision API ユーザー, Cloud TTS/STT ユーザー
# 4. 鍵タブ → 鍵を追加 → JSON形式でダウンロード
# 5. ダウンロードしたファイルを credentials/ に配置
#
# 詳細: credentials/README.md を参照
# ============================================

# GCPプロジェクト設定
GOOGLE_CLOUD_PROJECT=your-project-id

# Service Account JSON ファイルパス
# credentials/google-service-account.json に配置してください
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json

# Docker/Podman環境での認証情報パス（compose.ymlで使用）
GOOGLE_CREDENTIALS_PATH=./credentials

# ============================================
# OCR設定
# ============================================

# OCRプロバイダー（google_vision, azure_vision, tesseract）
# Service Account があれば google_vision を使用可能
OCR_PROVIDER=google_vision

# Azure Computer Vision API（google_vision の代替）
# AZURE_COMPUTER_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_COMPUTER_VISION_API_KEY=your_key_here

# ============================================
# TTS（音声合成）設定
# ============================================

# TTSプロバイダー（azure, google, edge, qwen）
# - azure: Azure Speech Services (140言語対応、要APIキー)
# - google: Google Cloud TTS (要Service Account)
# - edge: edge-tts (無料、50言語、APIキー不要)
# - qwen: Qwen-TTS (ローカルGPU、10言語、無料)
TTS_PROVIDER=azure

# Azure Speech Services (TTS_PROVIDER=azure の場合)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastasia

# Qwen-TTS設定 (TTS_PROVIDER=qwen の場合)
# ローカルGPUで動作、10言語対応（中英日韓独仏露葡西伊）
QWEN_TTS_URL=http://localhost:8001
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# ============================================
# STT（音声認識）設定
# ============================================

# STTプロバイダー（whisper, azure, google）
# - whisper: OpenAI Whisper (99言語対応、高精度)
# - azure: Azure Speech Services (要APIキー)
# - google: Google Cloud STT (要Service Account)
STT_PROVIDER=whisper

# OpenAI API (whisper STT / GPT LLM)
OPENAI_API_KEY=your_openai_key_here

# ============================================
# LLM設定
# ============================================

# LLMプロバイダー（claude, openai, gemini）
LLM_PROVIDER=claude

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_key_here

# ============================================
# レート制限設定
# ============================================

RATE_LIMIT_OCR=60
RATE_LIMIT_TTS=100
RATE_LIMIT_STT=60

# ============================================
# 詳細は以下のドキュメントを参照してください:
# - モック戦略: docs/mocking_strategy.md
# - 認証情報: credentials/README.md
# ============================================
